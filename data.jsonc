          { "id": "update-student", "src": "media/images/Face_attendance_system/Update Student details.png", "caption": "Update student details" },
          { "id": "account-details", "src": "media/images/Face_attendance_system/User account details.png", "caption": "Faculty account details" },
          { "id": "class-diagram", "src": "media/images/Face_attendance_system/Class Diagram.jpg", "caption": "Class diagram (UML)" },
          { "id": "activity-diagram", "src": "media/images/Face_attendance_system/Activity Diagram.jpg", "caption": "Activity diagram (UML)" },
          { "id": "usecase-admin", "src": "media/images/Face_attendance_system/use case Diagram for admin.jpg", "caption": "Use case diagram , admin" },
          { "id": "usecase-user", "src": "media/images/Face_attendance_system/use case Diagram for user.jpg", "caption": "Use case diagram , user" }
        ]
